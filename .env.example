# Configuration de l'API de scoring (copier en .env et adapter)

# Chemins des artefacts du modèle
MODEL_PATH=models/lgbm_final.joblib
MODEL_META_PATH=models/model_meta.json

# Seuil de décision métier (refus si proba >= seuil). Repris du Projet 6.
DECISION_THRESHOLD=0.49

# Stockage des données de production — base SQLite des appels (étape 3)
LOG_DB_PATH=monitoring/production_logs.db
# Active la journalisation des prédictions (mettre à false pour la désactiver)
MONITORING_ENABLED=true

# Niveau de log
LOG_LEVEL=INFO
